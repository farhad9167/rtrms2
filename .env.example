# Copy this file to .env and fill in YOUR values. Never share .env or commit it.
FLASK_SECRET_KEY=change-me-long-random   # python -c "import secrets; print(secrets.token_hex(32))"

# Google OAuth (restaurant owner login) - needs internet
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Super admin (platform owner) login
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Address people use to reach the gateway (QR codes + OAuth redirect). On a LAN use your PC IP.
PUBLIC_URL=http://localhost:5000
